# Copy to .env.local for local development, and add the same VITE_* values in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Everything prefixed VITE_ is bundled into the browser app, so ONLY public
# values belong here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://qrgbfxrzypqtckfdfkil.supabase.co
# anon / publishable key: Dashboard → Project Settings → API Keys
VITE_SUPABASE_ANON_KEY=

# Web Push public key (generate with `npm run vapid`)
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# NOT for Vercel / not VITE_-prefixed. The private VAPID key is only used by the
# Supabase Edge Function that sends pushes. Set it as a Supabase secret:
#   npx supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... \
#     VAPID_SUBJECT=mailto:you@example.com CRON_SECRET=...
# For `supabase functions serve` locally, use supabase/functions/.env instead.
# ---------------------------------------------------------------------------
